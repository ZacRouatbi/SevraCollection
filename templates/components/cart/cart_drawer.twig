{# templates/components/cart/cart_drawer.twig #}
<aside id="cart-drawer" class="cart-drawer" aria-label="Panier" role="complementary">

  {# ── Header ─────────────────────────────────────────────────── #}
  <div class="flex items-center justify-between px-6 py-5 border-b border-shadow/10">
    <p class="label" style="color:var(--c-olive-dark)">Votre panier</p>
    <button data-cart-close class="btn-ghost" aria-label="Fermer le panier">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  {# ── Items ──────────────────────────────────────────────────── #}
  <div class="flex-1 overflow-y-auto px-6 py-2" id="cart-items-list">
    {# Empty state #}
    <div id="cart-empty" class="flex flex-col items-center justify-center h-full py-16 text-center">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1" class="text-mauve mb-4" style="color:var(--c-mauve)">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <p class="font-display italic text-xl text-shadow mb-1">Votre panier est vide</p>
      <p class="text-sm text-mauve font-light mb-6">Découvrez notre collection.</p>
      <a href="{{ path('shop') }}" class="btn-outline" data-cart-close>Explorer</a>
    </div>

    {# Cart item template (rendered by JS from API data) #}
    {# In full integration, this loop comes from session/API via the controller #}
    {# Example static structure for styling reference: #}
    {#
    <div class="cart-item">
      <img src="/images/placeholder.jpg" alt="Ensemble Laine Kaki" class="cart-item__img">
      <div class="flex-1 min-w-0">
        <p class="font-display italic text-lg leading-tight mb-0.5">Ensemble Kaki</p>
        <p class="label mb-2">Pantalon · Taille M</p>
        <div class="flex items-center justify-between">
          <div class="qty-stepper">
            <button data-qty-dec>−</button>
            <span>1</span>
            <button data-qty-inc>+</button>
          </div>
          <p class="font-display italic text-lg" style="color:var(--c-olive)">89 DT</p>
        </div>
      </div>
    </div>
    #}
  </div>

  {# ── Footer / Summary ───────────────────────────────────────── #}
  <div class="px-6 py-6 border-t border-shadow/10 bg-white/50">
    <div class="summary-row total">
      <span>Total</span>
      <span id="cart-total" style="color:var(--c-olive)">0 DT</span>
    </div>
    <a href="{{ path('checkout') }}" class="btn-primary w-full justify-center mt-4 block text-center">
      Commander
    </a>
    <p class="text-center text-xs text-mauve mt-3 font-light">
      Livraison calculée à l'étape suivante
    </p>
  </div>

</aside>
