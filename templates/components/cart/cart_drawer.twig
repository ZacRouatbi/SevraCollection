{#
  We use the global 'cart_service' registered in twig.yaml.
  The service uses the session key 'sevra_cart'.
#}
{% set items = cart_service.getItems() %}
{% set total_price = cart_service.getSubtotal() %}
{% set total_count = cart_service.getCount() %}

<aside id="cart-drawer" class="cart-drawer flex flex-col h-full" aria-label="Panier" role="complementary">

  {# ── Header ─────────────────────────────────────────────────── #}
  <div class="flex items-center justify-between px-6 py-5 border-b" style="border-color:rgba(32,32,48,0.08)">
    <div class="flex items-center gap-3">
      <p class="label" style="color:var(--c-olive-dark)">Votre panier</p>
      <span id="drawer-count-badge" style="
        display: {{ total_count > 0 ? 'flex' : 'none' }};
        background: var(--c-olive);
        color: var(--c-snow);
        font-size: 0.6rem;
        font-family: var(--font-body);
        font-weight: 500;
        letter-spacing: 0.08em;
        width: 18px; height: 18px;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
      ">{{ total_count }}</span>
    </div>
    <button data-cart-close class="btn-ghost" aria-label="Fermer le panier">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  {# ── Items list ─────────────────────────────────────────────── #}
  <div class="flex-1 overflow-y-auto px-6 py-2" id="cart-items-list">

    {# Empty state — uses 'items' variable #}
    <div id="cart-empty" class="flex-col items-center justify-center h-full py-16 text-center"
         style="display: {{ items is empty ? 'flex' : 'none' }}">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="mb-4" style="color:var(--c-mauve)">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <p class="font-display italic text-xl mb-1" style="color:var(--c-shadow)">Votre panier est vide</p>
      <a href="{{ path('shop') }}" class="btn-outline mt-4" data-cart-close>Explorer</a>
    </div>

    {# Populated state #}
    <div id="cart-items-inner" class="divide-y"
         style="divide-color:rgba(32,32,48,0.07); display: {{ items is not empty ? 'block' : 'none' }}">
      {% for item in items %}
      <div class="cart-item py-5" data-item-key="{{ item.key }}">
        <div class="flex gap-4">
          <img src="{{ item.image }}" alt="{{ item.name }}" class="cart-item__img" style="width: 72px; height: 96px; object-fit: cover;">

          <div class="flex-1 min-w-0 flex flex-col justify-between">
            <div class="flex justify-between items-start gap-2">
              <div>
                <p class="font-display italic text-lg leading-tight mb-0.5">{{ item.name }}</p>
                <p class="label mb-2" style="font-size:0.65rem">
                  {% if item.size %}Taille {{ item.size }}{% endif %}
                  {% if item.size and item.color %} · {% endif %}
                  {% if item.color %}{{ item.color }}{% endif %}
                </p>
              </div>
              <button class="btn-ghost remove-item-btn" data-item-key="{{ item.key }}" style="color:var(--c-mauve)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                </svg>
              </button>
            </div>

            <div class="flex items-center justify-between mt-1">
              <div style="display:flex; align-items:center; border:1px solid rgba(32,32,48,0.18)">
                <button type="button" class="page-qty-btn" data-item-key="{{ item.key }}" data-delta="-1" style="width:28px; height:28px;">−</button>
                <span class="page-qty-display" data-item-key="{{ item.key }}" style="width:26px; text-align:center;">{{ item.qty }}</span>
                <button type="button" class="page-qty-btn" data-item-key="{{ item.key }}" data-delta="1" style="width:28px; height:28px;">+</button>
              </div>
              <p class="font-display italic text-lg item-line-total ml-4" data-item-key="{{ item.key }}" data-price="{{ item.price }}" data-qty="{{ item.qty }}" style="color:var(--c-olive)">
                {{ (item.price * item.qty)|number_format(2, '.', '') }} DT
              </p>
            </div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  {# ── Footer ──────────────────────────────────────────────────── #}
  <div class="px-6 py-6 border-t" style="border-color:rgba(32,32,48,0.08); background:rgba(253,250,247,0.6)">
    <div class="summary-row total flex justify-between font-display italic text-xl mb-4">
      <span>Total</span>
      <span id="drawer-total" style="color:var(--c-olive)">{{ total_price|number_format(2, '.', '') }} DT</span>
    </div>
    <a href="{{ path('cart') }}" class="btn-outline w-full justify-center mt-3 block text-center">Voir le panier</a>
    <a href="{{ path('checkout') }}" class="btn-primary w-full justify-center mt-2 block text-center">Commander</a>
  </div>

</aside>
