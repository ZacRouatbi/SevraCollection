{# templates/components/cart/cart_drawer.twig #}
<aside id="cart-drawer" class="cart-drawer" aria-label="Panier" role="complementary">

  {# ── Header ─────────────────────────────────────────────────── #}
  <div class="flex items-center justify-between px-6 py-5 border-b" style="border-color:rgba(32,32,48,0.08)">
    <div class="flex items-center gap-3">
      <p class="label" style="color:var(--c-olive-dark)">Votre panier</p>
      <span id="drawer-count-badge" style="
        display:none;
        background:var(--c-olive);
        color:var(--c-snow);
        font-size:0.6rem;
        font-family:var(--font-body);
        font-weight:500;
        letter-spacing:0.08em;
        width:18px; height:18px;
        border-radius:50%;
        align-items:center;
        justify-content:center;
      ">0</span>
    </div>
    <button data-cart-close class="btn-ghost" aria-label="Fermer le panier">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  {# ── Items list (hydrated by JS) ─────────────────────────────── #}
  <div class="flex-1 overflow-y-auto px-6 py-2" id="cart-items-list">

    {# Empty state — shown by default, hidden by JS when items exist #}
    <div id="cart-empty" class="flex flex-col items-center justify-center h-full py-16 text-center">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1" class="mb-4" style="color:var(--c-mauve)">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <p class="font-display italic text-xl mb-1" style="color:var(--c-shadow)">Votre panier est vide</p>
      <p class="text-sm font-light mb-6" style="color:var(--c-mauve)">Découvrez notre collection.</p>
      <a href="{{ path('shop') }}" class="btn-outline" data-cart-close>Explorer</a>
    </div>

    {# Items injected here by cart.js #}
    <div id="cart-items-inner" style="display:none"></div>

  </div>

  {# ── Footer ──────────────────────────────────────────────────── #}
  <div class="px-6 py-6 border-t" style="border-color:rgba(32,32,48,0.08); background:rgba(253,250,247,0.6)">
    <div class="summary-row total">
      <span>Total</span>
      <span id="drawer-total" style="color:var(--c-olive)">0 DT</span>
    </div>
    <a href="{{ path('cart') }}" class="btn-outline w-full justify-center mt-3 block text-center">
      Voir le panier
    </a>
    <a href="{{ path('checkout') }}" class="btn-primary w-full justify-center mt-2 block text-center">
      Commander
    </a>
    <p class="text-center font-light mt-3" style="font-size:0.7rem; color:var(--c-mauve)">
      Livraison calculée à l'étape suivante
    </p>
  </div>

</aside>
