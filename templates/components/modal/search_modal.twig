{# templates/components/modal/search_modal.twig #}
<div id="search-overlay" class="fixed inset-0 z-[999] flex items-start justify-center pt-20 md:pt-32 px-6"
      style="opacity:0; visibility:hidden; pointer-events:none; background-color: rgba(253,250,247,0.75); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%);">

    <div class="relative w-full max-w-3xl" id="search-content">
        {# Close Button #}
        <button id="search-close" class="absolute -top-12 md:-top-16 right-0 text-shadow hover:rotate-90 transition-transform duration-300">
            <svg width="28" height="28" class="md:w-8 md:h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>

        {# Search Input #}
        <input type="text" id="search-overlay-input" placeholder="Que recherchez-vous ?" autocomplete="off"
               class="w-full bg-transparent text-2xl md:text-5xl font-display italic text-shadow border-b border-shadow/10 outline-none pb-4 placeholder:text-shadow/20">

        {# Results dropdown #}
        <div id="search-results" class="hidden mt-4 max-h-[60vh] overflow-y-auto rounded-sm shadow-2xl border border-olive/10"
             style="background: rgba(253,250,247,0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);">
        </div>

        <div id="search-suggestions" class="hidden mt-3 flex flex-wrap gap-2"></div>

        {# ✅ FIXED: 2 simple redirect buttons (always visible) #}
        <div class="mt-4 flex flex-wrap gap-2">
            <button onclick="window.location.href='/shop'"
                    class="px-4 md:px-5 py-2 border border-shadow/10 rounded-full text-shadow hover:bg-shadow hover:text-cream transition-all duration-300 text-xs md:text-sm">
                Ensemble Lin
            </button>
            <button onclick="window.location.href='/gallery'"
                    class="px-4 md:px-5 py-2 border border-shadow/10 rounded-full text-shadow hover:bg-shadow hover:text-cream transition-all duration-300 text-xs md:text-sm">
                Nouveautés
            </button>
        </div>

    </div>
</div>

<script>
  // Initialize search modal immediately so other scripts can call window.openSearch
  const _search_overlay = document.getElementById('search-overlay');
  const _search_input = document.getElementById('search-overlay-input');
  const _search_results = document.getElementById('search-results');
  const _search_close = document.getElementById('search-close');

  if (_search_overlay && _search_input) {
    let debounceTimer;

    const openSearch = () => {
      const overlay = _search_overlay;
      overlay.style.transition = 'opacity 0.4s ease';
      overlay.style.opacity = '0';
      overlay.style.visibility = 'visible';
      overlay.style.pointerEvents = 'auto';
      document.body.style.overflow = 'hidden';
      // trigger reflow
      overlay.offsetHeight;
      overlay.style.opacity = '1';
      setTimeout(() => { _search_input.focus(); }, 50);
    };

    const closeSearch = () => {
      const overlay = _search_overlay;
      overlay.style.transition = 'opacity 0.3s ease';
      overlay.style.opacity = '0';
      setTimeout(() => {
        overlay.style.visibility = 'hidden';
        overlay.style.pointerEvents = 'none';
        document.body.style.overflow = '';
        resetSearch();
      }, 300);
    };

    function resetSearch() {
      _search_input.value = '';
      if (_search_results) {
        _search_results.innerHTML = '';
        _search_results.classList.add('hidden');
      }
    }

    // Expose immediately
    window.openSearch = openSearch;

    _search_input.addEventListener('input', function() {
      const query = this.value.trim();
      clearTimeout(debounceTimer);
      if (query.length < 2) {
        if (_search_results) {
          _search_results.innerHTML = '';
          _search_results.classList.add('hidden');
        }
        return;
      }

      debounceTimer = setTimeout(async () => {
        if (!_search_results) return;
        try {
          const res = await fetch('/api/search?q=' + encodeURIComponent(query));
          const products = await res.json();
          if (products.length === 0) {
            _search_results.innerHTML = '<div class="p-4 text-center text-sm text-mauve">Aucun résultat</div>';
          } else {
            _search_results.innerHTML = products.map(p => `
              <a href="/produit/${p.slug}" class="flex items-center gap-4 p-3 hover:bg-white/30 transition-colors border-b border-shadow/5 last:border-0">
                <img src="${p.image}" alt="${p.name}" class="w-12 h-16 object-cover flex-shrink-0" />
                <div class="flex-1 min-w-0">
                  <p class="font-display italic text-sm text-shadow">${p.name}</p>
                  <p class="text-xs text-mauve">${p.price} DT</p>
                </div>
              </a>
            `).join('');
          }
          _search_results.classList.remove('hidden');
        } catch (err) {
          _search_results.innerHTML = '<div class="p-4 text-center text-sm text-red-400">Erreur de recherche</div>';
          _search_results.classList.remove('hidden');
        }
      }, 300);
    });

    _search_close?.addEventListener('click', closeSearch);
    _search_overlay.addEventListener('click', (e) => { if (e.target === _search_overlay) closeSearch(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && _search_overlay.style.visibility === 'visible') closeSearch(); });
  }
</script>
