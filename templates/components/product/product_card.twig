{# templates/components/product/product_card.twig #}
<article class="product-card flex flex-col h-full data-id="{{ product.product_id ?? product.id ?? product.sku ?? '' }}"">
  <div class="block overflow-hidden relative group"> {# Changed <a> to <div> here to separate concerns #}
    <div class="overflow-hidden relative aspect-[3/4]">

      {# The Main Image Link #}
      <a href="{{ path('product_detail', { slug: product.slug ?? '#' }) }}" class="absolute inset-0 z-0">
        <img
          src="{{ product.images[0] ?? '/images/placeholder.jpg' }}"
          alt="{{ product.name ?? 'Ensemble' }}"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
      </a>

      {# Badges #}
      {% if product.on_sale|default(false) %}
        <span class="absolute top-3 right-3 label px-2 py-1 z-10" style="background:var(--c-shadow); color:var(--c-snow); pointer-events: none;">
          Soldes
        </span>
      {% endif %}

      {# Quick-add overlay - Notice the z-20 and pointer-events-none on the wrapper #}
      <div class="absolute inset-0 flex items-end justify-center pb-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
           style="background:linear-gradient(to top, rgba(32,32,48,0.3) 0%, transparent 60%)">

        {# THE BUTTON - added pointer-events-auto and z-20 #}
        <button
        type="button"
        class="btn-primary js-quick-add pointer-events-auto"
        style="font-size:0.68rem; padding:0.65rem 1.4rem; position: relative; z-index: 20;"
        {# Try multiple common ID field names just in case #}
        data-product-id="{{ product.id ?? product._id ?? product.productId ?? '' }}">
        Ajouter au panier
        </button>
      </div>
    </div>
  </div>

  <div class="product-card__body flex flex-col flex-grow pt-4">
    <a href="{{ path('product_detail', { slug: product.slug ?? '#' }) }}" class="hover:opacity-70 transition-opacity">
      <h3 class="product-card__name">{{ product.name ?? 'Ensemble Sevra' }}</h3>
    </a>
    <p class="product-card__price mt-auto">
       {{ product.price|default('0') }} DT
    </p>
  </div>
</article>
