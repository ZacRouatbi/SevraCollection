{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Sevra Collection{% endblock %}</title>
  <meta name="csrf-token" content="{{ csrf_token('cart') }}">
  {# OPTIMIZED: Google Fonts with display=swap for performance #}
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"></noscript>

  {# OPTIMIZED: Use local Tailwind build instead of CDN in production #}
  {% if app.environment == 'prod' %}
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  {% else %}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              olive: 'var(--c-olive)',
              snow: 'var(--c-snow)',
              shadow: 'var(--c-shadow)',
              mauve: 'var(--c-mauve)',
              cream: 'var(--c-white)',
            },
            fontFamily: {
              display: ['var(--font-display)'],
              body: ['var(--font-body)'],
            },
          }
        }
      }
    </script>
  {% endif %}

  <link rel="stylesheet" href="{{ asset('css/sevra.css') }}">
  {% block head_extra %}{% endblock %}
</head>
<body class="bg-linen font-body antialiased">

  {# ── Header ── #}
  {% include 'components/header/header.twig' %}

  {# ── Main Content ── #}
  <main class="min-h-screen" id="main-content">
    {% block content %}{% endblock %}
  </main>

  {# ── Footer ── #}
  {% include 'components/footer/footer.twig' %}

  {# ── Modals & Overlays ── #}
  {% include 'components/modal/auth_modal.twig' %}
  {% include 'components/modal/search_modal.twig' %}
    {% include 'components/modal/footer_modals.twig' %}
  {# The Drawer now has access to cart_service via Twig Globals #}
  {% include 'components/cart/cart_drawer.twig' %}

  <div id="cart-overlay"
       class="fixed inset-0 bg-shadow/40 backdrop-blur-sm z-[150] opacity-0 pointer-events-none transition-opacity duration-300 [&.is-open]:opacity-100 [&.is-open]:pointer-events-auto"
       data-cart-close></div>

  <div class="toast" role="status" aria-live="polite"></div>

  {# ── OPTIMIZED: Scripts with proper loading strategies ── #}

  {# GSAP - Only load on pages that need animations #}
  {% if app.request.attributes.get('_route') starts with 'home' %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>
  {% endif %}

  {# Core UI Logic - Remove cache-busting timestamp in production #}
  {% if app.environment == 'prod' %}
    <script src="{{ asset('js/sevra.js') }}" defer></script>
    <script src="{{ asset('js/cart.js') }}" defer></script>
    <script src="{{ asset('js/cart-actions.js') }}" defer></script>
  {% else %}
    <script src="{{ asset('js/sevra.js') }}?v={{ "now"|date("U") }}" defer></script>
    <script src="{{ asset('js/cart.js') }}?v={{ "now"|date("U") }}" defer></script>
    <script src="{{ asset('js/cart-actions.js') }}?v={{ "now"|date("U") }}" defer></script>
  {% endif %}

  {% block scripts_extra %}

  {% endblock %}
</body>
</html>
